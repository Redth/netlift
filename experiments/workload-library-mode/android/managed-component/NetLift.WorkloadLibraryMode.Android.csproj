<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <ApplicationId>dev.netlift.workloadlibrarymode.component</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <UseMonoRuntime>false</UseMonoRuntime>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TrimMode>copy</TrimMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../product/src/NetLift.Runtime/NetLift.Runtime.csproj" />
    <ProjectReference Include="../../../../product/samples/Orders.Contracts/Orders.Contracts.csproj" />
    <Compile Include="$(NetLiftGeneratedDirectory)/NetLiftDispatcher.g.cs"
             Condition="'$(NetLiftGeneratedDirectory)' != ''"
             Link="Generated/NetLiftDispatcher.g.cs" />
    <Compile Include="../../../../product/artifacts/generated/NetLiftDispatcher.g.cs"
             Condition="'$(NetLiftGeneratedDirectory)' == ''"
             Link="Generated/NetLiftDispatcher.g.cs" />
  </ItemGroup>
</Project>
