{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netlift.dev/schemas/workload-component-v1.json",
  "title": "NetLift workload component manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platform",
    "runtimeFlavor",
    "targetFramework",
    "runtimeIdentifier",
    "dotnetSdkVersion",
    "workloadManifest",
    "initializationAbiVersion",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "platform": {
      "enum": [
        "android",
        "ios",
        "iossimulator"
      ]
    },
    "runtimeFlavor": {
      "enum": [
        "CoreCLR",
        "MonoVM",
        "NativeAOT"
      ]
    },
    "targetFramework": {
      "type": "string",
      "minLength": 1
    },
    "runtimeIdentifier": {
      "type": "string",
      "minLength": 1
    },
    "dotnetSdkVersion": {
      "type": "string",
      "minLength": 1
    },
    "workloadManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "initializationAbiVersion": {
      "type": "integer",
      "minimum": 1
    },
    "minimumOSVersion": {
      "type": "string",
      "minLength": 1
    },
    "minimumAndroidSdk": {
      "type": "integer",
      "minimum": 1
    },
    "registrarMode": {
      "type": "string"
    },
    "typemapMode": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "managed-assembly",
              "native-library",
              "assembly-store",
              "registrar",
              "typemap",
              "java-wrapper",
              "resource",
              "configuration"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
