<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../samples/Orders.Contracts/Orders.Contracts.csproj" />
    <ProjectReference Include="../../src/NetLift.Tool/NetLift.Tool.csproj"
                      ReferenceOutputAssembly="false" />
    <Compile Include="../../artifacts/generated/NetLiftDispatcher.g.cs"
             Link="NetLiftDispatcher.g.cs" />
  </ItemGroup>
  <Target Name="GenerateNetLiftDispatcher"
          BeforeTargets="CoreCompile"
          Inputs="../../netlift.json;../../samples/Orders.Contracts/bin/$(Configuration)/net11.0/Orders.Contracts.dll"
          Outputs="../../artifacts/generated/NetLiftDispatcher.g.cs">
    <Exec Command="dotnet run --project ../../src/NetLift.Tool --no-build --configuration $(Configuration) -- ../../netlift.json" />
  </Target>
</Project>
