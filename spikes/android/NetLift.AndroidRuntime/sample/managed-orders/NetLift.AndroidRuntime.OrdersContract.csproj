<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
    <DefineConstants>$(DefineConstants);NETLIFT_TYPED_REPLY_V3</DefineConstants>
    <AssemblyName>NetLift.AndroidRuntime.OrdersContract</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../../../tests/NetLift.NativeHost.Managed/Contract.cs" Link="Contract.cs" />
    <ProjectReference Include="../../../../../src/NetLift.Contracts/NetLift.Contracts.csproj" />
    <ProjectReference Include="../../../../../src/NetLift.Generator/NetLift.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../../../samples/Orders.Business/Orders.Business.csproj" />
  </ItemGroup>
</Project>
