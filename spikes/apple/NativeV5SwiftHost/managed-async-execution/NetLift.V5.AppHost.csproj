<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <AssemblyName>NetLift.V5.AppHost</AssemblyName>
    <DefineConstants>$(DefineConstants);NETLIFT_V5_ASYNC_RESULT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference
      Include="../../../../tests/NetLift.Negotiation.NativeHost.AsyncRuntime/Managed.Old/NetLift.Negotiation.NativeHost.AsyncRuntime.Managed.Old.csproj"
      Aliases="global,AsyncOld" />
    <ProjectReference
      Include="../../../../tests/NetLift.Negotiation.NativeHost.AsyncRuntime/Managed.New/NetLift.Negotiation.NativeHost.AsyncRuntime.Managed.New.csproj"
      Aliases="global,AsyncNew" />
    <Compile Include="../managed/EntryPoints.cs" Link="EntryPoints.cs" />
    <Compile Include="../managed-async/EntryPoints.Async.cs" Link="EntryPoints.Async.cs" />
  </ItemGroup>
</Project>
