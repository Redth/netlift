<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>ManagedProbe</AssemblyName>
    <RootNamespace>BootstrapLoadIdentity</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ProbeVariant Condition="'$(ProbeVariant)' == ''">old</ProbeVariant>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ProbeVariant)' == 'new'">
    <DefineConstants>$(DefineConstants);PROBE_NEW</DefineConstants>
  </PropertyGroup>
</Project>
