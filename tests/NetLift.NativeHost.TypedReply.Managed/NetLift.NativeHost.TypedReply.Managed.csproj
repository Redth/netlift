<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);NETLIFT_TYPED_REPLY_V3</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../NetLift.NativeHost.Managed/Contract.cs" Link="Contract.cs" />
    <Compile Include="../NetLift.NativeHost.Managed/AsyncContract.cs" Link="AsyncContract.cs" />
    <Compile Include="../NetLift.NativeHost.Managed/NativeApi.cs" Link="NativeApi.cs" />
    <Compile Include="../NetLift.NativeHost.Managed/NativeAsyncApi.cs" Link="NativeAsyncApi.cs" />
    <Compile Include="../NetLift.NativeHost.Managed/AsyncLifecycle.cs" Link="AsyncLifecycle.cs" />
    <ProjectReference Include="../../src/NetLift.Contracts/NetLift.Contracts.csproj" />
    <ProjectReference Include="../../src/NetLift.Generator/NetLift.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
