<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);NETLIFT_V5_ASYNC_RESULT;NETLIFT_V5_NEW;NETLIFT_ASYNC_RUNTIME;NETLIFT_ASYNC_RUNTIME_NEW</DefineConstants>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <AssemblyName>NetLift.Negotiation.NativeHost.AsyncRuntime.Managed.New</AssemblyName>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../NetLift.Negotiation.AsyncHost.Managed.New/NetLift.Negotiation.AsyncHost.Managed.New.csproj" />
    <ProjectReference Include="../../../src/NetLift.ManagedHost/NetLift.ManagedHost.csproj" />
    <ProjectReference Include="../../../src/NetLift.Negotiation/NetLift.Negotiation.csproj" />
    <Compile Include="../../NetLift.Negotiation.NativeHost.Managed.Shared/NativeApi.cs"
             Link="NativeApi.cs" />
    <Compile Include="../Managed/ManagedAppEndpointDescriptorFactory.cs"
             Link="ManagedAppEndpointDescriptorFactory.cs" />
    <Compile Include="../Managed/ManagedAppEndpointLiveBindingPublisher.cs"
             Link="ManagedAppEndpointLiveBindingPublisher.cs" />
    <Compile Include="../Managed/AsyncRuntimeApi.cs" Link="AsyncRuntimeApi.cs" />
  </ItemGroup>
</Project>
