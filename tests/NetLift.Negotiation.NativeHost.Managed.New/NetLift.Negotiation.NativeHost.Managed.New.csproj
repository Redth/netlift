<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <AssemblyName>NetLift.Negotiation.NativeHost.Managed.New</AssemblyName>
    <DefineConstants>$(DefineConstants);NETLIFT_V5_NEW</DefineConstants>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NetLift.Contracts/NetLift.Contracts.csproj" />
    <ProjectReference Include="../../src/NetLift.Generator/NetLift.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/NetLift.Negotiation/NetLift.Negotiation.csproj" />
    <Compile Include="../NetLift.Negotiation.NativeHost.Managed.Shared/NativeApi.cs"
             Link="NativeApi.cs" />
  </ItemGroup>
</Project>
